#!/usr/bin/env python3
"""Every commit: deterministic disclosure check over the staged diff. Enable with install.py."""
import subprocess
import sys
from pathlib import Path

root = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
sys.path.insert(0, str(root / "scripts"))
import disclosure  # noqa: E402

staged = subprocess.check_output(
    ["git", "diff", "--cached", "--no-color", "--no-ext-diff", "--no-textconv"], text=True, errors="replace"
)
sys.exit(0 if disclosure.check(staged, "staged") else 1)
