#!/usr/bin/env python3
"""Every commit: the message itself goes through the deterministic disclosure check."""
import subprocess
import sys
from pathlib import Path

root = Path(subprocess.check_output(["git", "rev-parse", "--show-toplevel"], text=True).strip())
sys.path.insert(0, str(root / "scripts"))
import disclosure  # noqa: E402

sys.exit(0 if disclosure.check(Path(sys.argv[1]).read_text(errors="replace"), "commit message") else 1)
